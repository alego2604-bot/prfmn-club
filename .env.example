# Copia a .env.local. SOLO claves públicas: todo lo que lleva VITE_ acaba en el navegador.
VITE_APP_ENV=development

# Fase 5 (aún no usadas por la app: mientras estén vacías funciona en modo local)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ⚠ Nunca pongas aquí service_role, Stripe secret, tokens de WhatsApp, claves de IA, etc.
#    Van en Supabase Edge Functions: `supabase secrets set NOMBRE=valor`
